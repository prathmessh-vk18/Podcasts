# Copy to .env (never commit .env). Everything is optional in development.
# Production refuses to start without SESSION_SECRET, TOKEN_ENCRYPTION_KEY, DATABASE_URL and an https PUBLIC_API_URL.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173

# Postgres in production. Leave empty locally to use embedded PGlite at PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite

# openssl rand -base64 48
SESSION_SECRET=
# openssl rand -base64 32   (must decode to exactly 32 bytes)
TOKEN_ENCRYPTION_KEY=
# Previous keys during rotation, comma-separated (decrypt only)
TOKEN_ENCRYPTION_KEYS_OLD=

APPLE_COUNTRY=us

# https://developer.spotify.com/dashboard — add redirect URI:
#   http://localhost:4000/v1/connections/spotify/callback   (use 127.0.0.1 if Spotify rejects localhost)
# Development Mode: max 5 allowlisted users; the app owner needs Spotify Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US

# https://console.cloud.google.com — enable "YouTube Data API v3", create an API key, and an
# OAuth client (Web) with redirect URI http://localhost:4000/v1/connections/youtube/callback
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REGION=US
YOUTUBE_DAILY_QUOTA=10000

MATCH_CACHE_DAYS=7
JOB_CONCURRENCY=2
