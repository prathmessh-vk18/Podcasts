{
  "name": "tangent",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev -w @tangent/api",
    "dev:web": "npm run dev -w @tangent/web",
    "build": "npm run build -w @tangent/api && npm run build -w @tangent/web",
    "start": "npm run start -w @tangent/api",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w @tangent/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run generate -w @tangent/db",
    "db:migrate": "npm run db:migrate -w @tangent/api",
    "catalog:refresh": "npm run catalog:refresh -w @tangent/api",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.4",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "postcss": "^8.5.30"
  }
}
